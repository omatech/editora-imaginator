{
  "name": "omatech/editora-imaginator",
  "description": "",
  "require": {
    "omatech/laravel-imaginator": "^1.0|^2.0",
    "league/glide": "^2.0 || ^3.0 || ^4.0",
    "symfony/http-kernel": "^5.0 || ^6.0 || ^7.0 || ^8.0"
  },
  "authors": [
    {
      "name": "Christian Bohollo",
      "email": "cbohollo@omatech.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Omatech\\Editora\\Imaginator\\": "src"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.12"
    },
    "allow-plugins": false,
    "sort-packages": true,
    "github-protocols": [
      "https"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.6",
    "orchestra/testbench": "^11.3.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test",
      "@composer validate --no-check-publish",
      "@composer audit --locked"
    ]
  }
}
